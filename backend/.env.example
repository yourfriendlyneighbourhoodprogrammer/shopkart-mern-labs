# Copy to backend/.env. Never commit actual credentials.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/shopkart?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Only Test Mode keys are accepted. Other features work without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
