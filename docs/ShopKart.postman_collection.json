{
  "info": {
    "name": "ShopKart Labs 01\u201306",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Core API flow against a disposable development database. Razorpay folder requires actual Test Mode keys and checkout response."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "shopKartOrderId",
      "value": ""
    },
    {
      "key": "razorpayOrderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "signature",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Core API flow",
      "item": [
        {
          "name": "01 Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/customers/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test\",\n  \"email\": \"{{email}}\",\n  \"password\": \"LabTest123\",\n  \"phone\": \"9000000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'lab-' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Password excluded', () => pm.expect(pm.response.json().customer).not.to.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/customers/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"LabTest123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  ""
                ]
              }
            }
          ]
        },
