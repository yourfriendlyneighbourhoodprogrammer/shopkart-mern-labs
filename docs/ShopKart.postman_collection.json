            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Keyboard\",\n  \"description\": \"Test product\",\n  \"price\": 2999,\n  \"stock\": 5,\n  \"category\": \"Electronics\",\n  \"image\": \"/images/keyboard.svg\"\n}",
              "options": {
                "raw": {
